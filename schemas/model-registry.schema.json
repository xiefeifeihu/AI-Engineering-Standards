{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/model-registry.schema.json",
  "title": "Model Registry Entity Schema",
  "type": "object",
  "required": [
    "id",
    "logical_model_id",
    "provider",
    "channel",
    "resource_id",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "logical_model_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "local-cpa",
        "cloud-cpa",
        "ollama"
      ]
    },
    "resource_id": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "type_code": {
      "type": "string",
      "enum": [
        "chat",
        "reasoning",
        "embedding",
        "multimodal"
      ]
    },
    "capability_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_window": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "QUARANTINED",
        "RECOVERING"
      ]
    }
  }
}
