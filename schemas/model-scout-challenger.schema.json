{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Scout and Challenger Contract Schema",
  "description": "STD-026 Model Scout Source, Candidate, Campaign, Fairness Specification, Microbench, Challenge Memory and Promotion Recommendations",
  "type": "object",
  "definitions": {
    "sourceType": {
      "type": "string",
      "enum": [
        "ACTIVE_RUNTIME_CATALOG",
        "OWNER_CANDIDATE_CATALOG",
        "PROVIDER_DECLARED_CATALOG",
        "OPTIONAL_PUBLIC_METADATA_CATALOG"
      ]
    },
    "sourceTrustLevel": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE_RUNTIME",
        "VERIFIED_OWNER",
        "UNVERIFIED_PUBLIC"
      ]
    },
    "availabilityClass": {
      "type": "string",
      "enum": [
        "AVAILABLE_NOW",
        "OWNER_ACTION_REQUIRED",
        "METADATA_ONLY"
      ]
    },
    "provenanceStatus": {
      "type": "string",
      "enum": [
        "LOCAL_RUNTIME",
        "CLOUD_TUNNEL",
        "OWNER_DECLARED",
        "PUBLIC_CATALOG",
        "UNVERIFIED"
      ]
    },
    "agentCompatibility": {
      "type": "string",
      "enum": [
        "AGENT_COMPATIBLE",
        "AGENT_INCOMPATIBLE",
        "AGENT_UNKNOWN"
      ]
    },
    "suiteType": {
      "type": "string",
      "enum": [
        "TECHNICAL_MICROBENCH",
        "AGENT_MICROBENCH",
        "CONSUMER_BUSINESS_EVALUATION"
      ]
    },
    "comparisonConclusion": {
      "type": "string",
      "enum": [
        "CHALLENGER_DOMINATES",
        "CHAMPION_RETAINS",
        "TRADEOFF",
        "INSUFFICIENT_EVIDENCE",
        "TECHNICALLY_INELIGIBLE",
        "BUSINESS_EVIDENCE_REQUIRED",
        "OWNER_ACTION_REQUIRED"
      ]
    },
    "recommendationType": {
      "type": "string",
      "enum": [
        "PROMOTION_RECOMMENDED",
        "PROMOTION_NOT_RECOMMENDED",
        "MORE_EVIDENCE_REQUIRED",
        "DEMOTION_RECOMMENDED"
      ]
    },
    "forbiddenSensitiveFields": {
      "type": "object",
      "not": {
        "anyOf": [
          {
            "required": [
              "api_key"
            ]
          },
          {
            "required": [
              "token"
            ]
          },
          {
            "required": [
              "password"
            ]
          },
          {
            "required": [
              "secret"
            ]
          },
          {
            "required": [
              "bearer"
            ]
          },
          {
            "required": [
              "oauth_token"
            ]
          },
          {
            "required": [
              "ssh_private_key"
            ]
          },
          {
            "required": [
              "prompt_body"
            ]
          },
          {
            "required": [
              "response_body"
            ]
          },
          {
            "required": [
              "source_code"
            ]
          },
          {
            "required": [
              "patch"
            ]
          },
          {
            "required": [
              "document_content"
            ]
          }
        ]
      }
    }
  },
