{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/engineering-manifest.schema.json",
  "title": "Engineering Project Manifest Schema (STD-001 Canonical)",
  "description": "Canonical schema for machine-readable AI engineering project manifests defining project identity, standards lock binding, document applicability, services, endpoints, credentials, and health contracts.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "services"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.0.0",
        "1.1",
        "1.1.0",
        "1.1.3",
        "1.2",
        "1.2.0",
        "1.3",
        "1.3.0",
        "2.0",
        "2.0.0"
      ]
    },
    "standards": {
      "type": "object",
      "description": "Standards version lock binding (must match standards.lock.json)",
      "properties": {
        "repository": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "standard_version": {
          "type": "string",
          "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "release_tag": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "tag_object_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "peeled_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "standard_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "lock_file": {
          "type": "string"
        }
      }
    },
    "standards_version": {
      "type": "string",
      "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
    },
    "standards_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "standards_tag": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "standards_tag_object": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "standards_lock_file": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "deployment_kind": {
          "type": "string",
          "enum": [
            "SERVICE",
            "NON_RUNTIME_ARTIFACT"
          ]
        },
        "repo_path_hints": {
          "type": "object",
          "properties": {
            "windows": {
              "type": "string"
            },
            "wsl": {
              "type": "string"
            }
          }
        },
        "consumer_contract": {
          "type": "object",
          "required": [
            "shared_inference"
          ],
          "properties": {
            "shared_inference": {
              "type": "string",
              "enum": [
                "REQUIRED",
                "NONE",
                "OPTIONAL"
              ]
            },
            "details": {
              "type": "string"
            }
          }
        },
        "network_gate_snapshot_hint": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "release_profile": {
          "type": "string",
          "enum": [
            "PERSONAL_LOCAL",
            "MAINTAINER_RELEASE",
            "HIGH_ASSURANCE"
          ]
        },
        "approval_mode": {
          "type": "string",
          "enum": [
            "OWNER_LOCAL_CONSENT",
            "AUTO_AFTER_GREEN",
            "MAINTAINER_APPROVAL",
            "GITHUB_ENVIRONMENT_REVIEW",
            "LOCAL_AUTHORIZED_KEY"
          ]
        },
        "release_policy_reference": {
          "type": "string"
        },
        "document_type_applicability": {
          "type": "object",
          "description": "Explicit applicability rules for STD-035 formal document types; non-applicable types require a justification",
          "propertyNames": {
            "enum": [
              "PROJECT_BLUEPRINT",
              "PRODUCT_BASELINE",
              "SYSTEM_ARCHITECTURE",
              "TECHNICAL_DESIGN",
              "API_CONTRACT",
              "PROTOTYPE_UX",
              "TEST_ACCEPTANCE",
              "RELEASE_OPERATIONS",
              "DECISION_RECORD",
              "CROSS_SESSION_HANDOFF",
              "DOCUMENT_INDEX",
              "ENGINEERING_BASELINE"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "applicable"
            ],
            "properties": {
              "applicable": {
                "type": "boolean"
              },
              "justification": {
                "type": "string",
                "minLength": 5
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "applicable": {
                      "const": false
                    }
                  },
                  "required": [
                    "applicable"
                  ]
                },
                "then": {
                  "required": [
                    "justification"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "category",
          "exposure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "project_app",
              "shared_ai_resource",
              "knowledge_data_infra",
              "machine_infra"
            ]
          },
          "exposure": {
            "type": "string",
            "enum": [
              "loopback",
              "docker_internal",
              "optional_tunnel",
              "none"
            ]
          },
          "lifecycle_policy": {
            "type": "string",
            "enum": [
              "ALWAYS_ON",
              "ON_DEMAND",
              "MANUAL",
              "EXTERNAL"
            ]
          },
          "desired_state": {
            "type": "string",
            "enum": [
              "RUNNING",
              "STOPPED"
            ]
          },
          "endpoints": {
            "type": "object",
            "properties": {
              "windows_host": {
                "type": "string"
              },
              "wsl_host": {
                "type": "string"
              },
              "docker_internal": {
                "type": "string"
              },
              "docker_consumer": {
                "type": "string"
              }
            }
          },
          "health_contract": {
            "type": "object",
            "required": [
              "probe_type"
            ],
            "properties": {
              "probe_type": {
                "type": "string",
                "enum": [
                  "http",
                  "tcp",
                  "docker_status",
                  "file_snapshot",
                  "none"
                ]
              },
              "endpoint": {
                "type": "string"
              },
              "expected_status": {},
              "optional": {
                "type": "boolean"
              },
              "timeout_seconds": {
                "type": "number"
              }
            }
          },
          "config_references": {
            "type": "array"
          },
          "credential_references": {
            "type": "array"
          },
          "lifecycle_commands": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
