{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/engineering-manifest.schema.json",
  "title": "Engineering Project Manifest Schema",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "services"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.0.0",
        "1.1",
        "1.1.0",
        "1.1.3"
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "repo_path_hints": {
          "type": "object",
          "properties": {
            "windows": {
              "type": "string"
            },
            "wsl": {
              "type": "string"
            }
          }
        },
        "consumer_contract": {
          "type": "object",
          "required": [
            "shared_inference"
          ],
          "properties": {
            "shared_inference": {
              "type": "string",
              "enum": [
                "REQUIRED",
                "NONE",
                "OPTIONAL"
              ]
            },
            "details": {
              "type": "string"
            }
          }
        },
        "network_gate_snapshot_hint": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "category",
          "exposure",
          "lifecycle_policy",
          "desired_state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "project_app",
              "shared_ai_resource",
              "knowledge_data_infra",
              "machine_infra"
            ]
          },
          "exposure": {
            "type": "string",
            "enum": [
              "loopback",
              "docker_internal",
              "optional_tunnel",
              "none"
            ]
          },
          "lifecycle_policy": {
            "type": "string",
            "enum": [
              "ALWAYS_ON",
              "ON_DEMAND",
              "MANUAL",
              "EXTERNAL"
            ]
          },
          "desired_state": {
            "type": "string",
            "enum": [
              "RUNNING",
              "STOPPED"
            ]
          },
          "endpoints": {
            "type": "object",
            "properties": {
              "windows_host": {
                "type": "string"
              },
              "wsl_host": {
                "type": "string"
              },
              "docker_internal": {
                "type": "string"
              },
              "docker_consumer": {
                "type": "string"
              }
            }
          },
          "health_contract": {
            "type": "object",
            "required": [
              "probe_type"
            ],
            "properties": {
              "probe_type": {
                "type": "string",
                "enum": [
                  "http",
                  "tcp",
                  "docker_status",
                  "file_snapshot",
                  "none"
                ]
              },
              "endpoint": {
                "type": "string"
              },
              "expected_status": {},
              "optional": {
                "type": "boolean"
              },
              "timeout_seconds": {
                "type": "number"
              }
            }
          },
          "config_references": {
            "type": "array"
          },
          "credential_references": {
            "type": "array"
          },
          "lifecycle_commands": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
