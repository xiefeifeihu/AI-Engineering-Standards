{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/two-stage-release-acceptance.schema.json",
  "title": "STD-014/STD-032 Two-stage release verification: live acceptance governs production readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "release_version",
    "target_commit",
    "deployment_kind",
    "pre_release",
    "deployment",
    "post_deploy",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "release_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployment_kind": {
      "enum": [
        "SERVICE",
        "NON_RUNTIME_ARTIFACT"
      ]
    },
    "pre_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "run_id",
        "tested_commit",
        "evidence_ref",
        "finished_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCK",
            "NOT_VERIFIABLE",
            "DEFERRED",
            "NOT_APPLICABLE"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 5
        },
        "tested_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1024
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "coverage_verification_ref": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1024
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCK",
            "NOT_VERIFIABLE",
            "DEFERRED",
            "NOT_APPLICABLE"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 5
        },
        "live_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "build_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "deployed_at": {
          "type": "string",
          "format": "date-time"
        },
        "identity_evidence_ref": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1024
        },
        "artifact_kind": {
          "enum": [
            "LOCAL_DOCKER_IMAGE_ID",
            "OCI_MANIFEST_DIGEST",
            "REGISTRY_REPODIGEST",
            "FILE_SHA256"
          ]
        },
        "artifact_value": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "post_deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCK",
            "NOT_VERIFIABLE",
            "DEFERRED",
            "NOT_APPLICABLE"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 5
        },
        "observed_live_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "coverage_plan_ref": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1024
        },
        "required_journey_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "journeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "journey_id",
              "status",
              "execution_mode",
              "real_endpoint",
              "expected_outcome_ref",
              "actual_outcome_ref",
              "evidence_ref"
            ],
            "properties": {
              "journey_id": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCK",
                  "NOT_VERIFIABLE",
                  "DEFERRED",
                  "NOT_APPLICABLE"
                ]
              },
              "execution_mode": {
                "enum": [
                  "LIVE_BROWSER",
                  "LIVE_API",
                  "LIVE_CLI",
                  "LIVE_INTEGRATION"
                ]
              },
              "real_endpoint": {
                "type": "string",
                "minLength": 3
              },
              "expected_outcome_ref": {
                "type": "string",
                "minLength": 8,
                "maxLength": 1024
              },
              "actual_outcome_ref": {
                "type": "string",
                "minLength": 8,
                "maxLength": 1024
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 8,
                "maxLength": 1024
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1024
        },
        "coverage_verification_ref": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1024
        }
      }
    },
    "published_artifact_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_ref",
        "verified_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCK",
            "NOT_VERIFIABLE",
            "DEFERRED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1024
        },
        "verified_ref": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1024
        }
      }
    },
    "tag_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCK"
      ]
    },
    "release_task_id": {
      "type": "string",
      "minLength": 3
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "overall_status"
        ],
        "properties": {
          "overall_status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "pre_release": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "tag_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "tag_commit"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "deployment_kind": {
                  "const": "SERVICE"
                }
              },
              "required": [
                "deployment_kind"
              ]
            },
            "then": {
              "properties": {
                "deployment": {
                  "properties": {
                    "status": {
                      "const": "PASS"
                    }
                  },
                  "required": [
                    "status",
                    "run_id",
                    "live_commit",
                    "build_commit",
                    "deployed_at",
                    "identity_evidence_ref",
                    "artifact_kind",
                    "artifact_value"
                  ]
                },
                "post_deploy": {
                  "properties": {
                    "status": {
                      "const": "PASS"
                    },
                    "journeys": {
                      "items": {
                        "properties": {
                          "status": {
                            "const": "PASS"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "status",
                    "run_id",
                    "observed_live_commit",
                    "started_at",
                    "finished_at",
                    "coverage_plan_ref",
                    "required_journey_ids",
                    "journeys",
                    "evidence_ref"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "deployment_kind": {
                  "const": "NON_RUNTIME_ARTIFACT"
                }
              },
              "required": [
                "deployment_kind"
              ]
            },
            "then": {
              "required": [
                "published_artifact_verification"
              ],
              "properties": {
                "published_artifact_verification": {
                  "properties": {
                    "status": {
                      "const": "PASS"
                    }
                  }
                },
                "deployment": {
                  "properties": {
                    "status": {
                      "const": "NOT_APPLICABLE"
                    }
                  }
                },
                "post_deploy": {
                  "properties": {
                    "status": {
                      "const": "NOT_APPLICABLE"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}