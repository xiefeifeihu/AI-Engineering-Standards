{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/test-coverage-verification.schema.json",
  "title": "STD-014/STD-034 AI-Driven Autonomous Test Coverage Verification Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "target_commit",
    "standards_version",
    "run_id",
    "stage",
    "impact_analysis",
    "required_case_ids",
    "cases",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 3
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "standards_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 5
    },
    "stage": {
      "enum": [
        "DEV_LOCAL",
        "PRE_RELEASE",
        "POST_DEPLOY"
      ]
    },
    "tested_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "impact_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impacted_requirements",
        "change_summary"
      ],
      "properties": {
        "impacted_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "change_summary": {
          "type": "string",
          "minLength": 5
        },
        "impacted_components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "risk_level": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        }
      }
    },
    "required_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "requirement_ref",
          "priority",
          "execution_mode",
          "stage",
          "test_path",
          "test_name",
          "status",
          "business_outcome",
          "outcome_assertion"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "requirement_ref": {
            "type": "string",
            "minLength": 2
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "test_kind": {
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "BOUNDARY",
              "REGRESSION"
            ],
            "description": "Test case category: positive journey, negative security/validation, boundary, or regression"
          },
          "execution_mode": {
            "enum": [
              "AUTOMATED_UNIT",
              "AUTOMATED_CONTRACT",
              "AUTOMATED_INTEGRATION",
              "LIVE_API",
              "LIVE_BROWSER",
              "LIVE_CLI",
              "SIMULATED",
              "UNEXECUTED"
            ]
          },
          "stage": {
            "enum": [
              "DEV_LOCAL",
              "PRE_RELEASE",
              "POST_DEPLOY"
            ]
          },
          "test_path": {
            "type": "string",
            "minLength": 3
          },
          "test_name": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCK",
              "NOT_RUN",
              "NOT_VERIFIABLE",
              "DEFERRED"
            ]
          },
          "business_outcome": {
            "enum": [
              "SUCCESS",
              "FAILURE",
              "BLOCK",
              "DEGRADED",
              "CONFIGURED",
              "MOCK_ONLY",
              "ERROR",
              "NOT_RECORDED"
            ]
          },
          "is_mocked": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "string",
            "minLength": 3
          },
          "tested_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "outcome_assertion": {
            "type": [
              "string",
              "object"
            ],
            "description": "Assertion expression, description, or structured verification payload"
          },
          "assertion_strength": {
            "enum": [
              "STRONG_BUSINESS_OUTCOME",
              "PAYLOAD_SCHEMA_VERIFIED",
              "WEAKENED",
              "TRIVIAL"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 3
          },
          "has_ui_error": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "retired_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "justification"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 3
          },
          "justification": {
            "type": "string",
            "minLength": 5
          },
          "replacement_case_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "approved_by": {
            "type": "string"
          }
        }
      }
    },
    "uncovered_p0_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "reason",
          "target_milestone"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 3
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "target_milestone": {
            "type": "string"
          }
        }
      }
    },
    "regression_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "defect_id",
          "status"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 3
          },
          "defect_id": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCK",
              "NOT_RUN"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCK",
        "NOT_VERIFIABLE"
      ]
    }
  }
}