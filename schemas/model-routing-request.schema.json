{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/model-routing-request.schema.json",
  "title": "Model Routing Intent Request Schema",
  "type": "object",
  "required": [
    "task"
  ],
  "properties": {
    "task": {
      "type": "string"
    },
    "quality": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "high"
    },
    "latency": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "batch"
      ],
      "default": "normal"
    },
    "multimodal_required": {
      "type": "boolean",
      "default": false
    },
    "preferred_channel": {
      "type": "string",
      "enum": [
        "local-cpa",
        "cloud-cpa",
        "ollama",
        "auto"
      ]
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 5
    },
    "consumer": {
      "type": "string"
    }
  }
}
