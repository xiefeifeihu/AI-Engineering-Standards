{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/model-routing-response.schema.json",
  "title": "Candidate Execution Plan Response Schema",
  "type": "object",
  "required": [
    "decision_id",
    "policy_version",
    "task",
    "requirements",
    "candidates",
    "fallback_policy"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "requirements": {
      "type": "object",
      "required": [
        "quality",
        "latency"
      ],
      "properties": {
        "quality": {
          "type": "string"
        },
        "latency": {
          "type": "string"
        },
        "multimodal_required": {
          "type": "boolean"
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "logical_model_id",
          "provider",
          "channel",
          "resource_id",
          "endpoint_reference",
          "score",
          "score_breakdown",
          "governance_state",
          "metrics",
          "reason"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "logical_model_id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "model_name": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "local-cpa",
              "cloud-cpa",
              "ollama"
            ]
          },
          "resource_id": {
            "type": "string"
          },
          "endpoint_reference": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": "number"
          },
          "score_breakdown": {
            "type": "object",
            "properties": {
              "ability": {
                "type": "number"
              },
              "channel": {
                "type": "number"
              },
              "success_rate": {
                "type": "number"
              },
              "latency": {
                "type": "number"
              },
              "quality": {
                "type": "number"
              },
              "failure_penalty": {
                "type": "number"
              },
              "circuit_penalty": {
                "type": "number"
              },
              "quota_penalty": {
                "type": "number"
              },
              "total": {
                "type": "number"
              },
              "normalized": {
                "type": "number"
              }
            }
          },
          "governance_state": {
            "type": "string",
            "enum": [
              "HEALTHY",
              "DEGRADED",
              "QUARANTINED",
              "RECOVERING"
            ]
          },
          "metrics": {
            "type": "object",
            "required": [
              "sample_count",
              "metric_confidence"
            ],
            "properties": {
              "sample_count": {
                "type": "integer"
              },
              "metric_confidence": {
                "type": "string",
                "enum": [
                  "NONE",
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "success_rate": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "latency_p50": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "latency_p95": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cold_start": {
                "type": "boolean"
              }
            }
          },
          "path_redundancy": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "diversity": {
      "type": "object",
      "properties": {
        "model_diversity": {
          "type": "integer"
        },
        "provider_diversity": {
          "type": "integer"
        },
        "channel_diversity": {
          "type": "integer"
        }
      }
    },
    "fallback_policy": {
      "type": "object",
      "required": [
        "strategy",
        "max_candidates",
        "description"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "max_candidates": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
