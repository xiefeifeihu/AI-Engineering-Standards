{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.local/release-approval-policy.schema.json",
  "title": "STD-032 ReleaseProfile explicit approval policy; PERSONAL_LOCAL consent or ten-gate automation; HIGH_ASSURANCE unchanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "branch",
    "approval_mode",
    "workflow",
    "environment",
    "max_age_seconds"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "release_profile": {
      "type": "string",
      "enum": [
        "PERSONAL_LOCAL",
        "MAINTAINER_RELEASE",
        "HIGH_ASSURANCE"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "branch": {
      "const": "main"
    },
    "approval_mode": {
      "enum": [
        "GITHUB_ENVIRONMENT_REVIEW",
        "LOCAL_AUTHORIZED_KEY",
        "OWNER_LOCAL_CONSENT",
        "MAINTAINER_APPROVAL",
        "AUTO_AFTER_GREEN"
      ]
    },
    "workflow": {
      "type": "string",
      "pattern": "^\\.github/workflows/[A-Za-z0-9_-]+\\.ya?ml$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "max_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "owner_consent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "confirmation_channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "require_explicit_consent": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "operator_identity",
        "confirmation_channel",
        "require_explicit_consent"
      ]
    },
    "local_authorized_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_evidence_ref",
        "keys"
      ],
      "properties": {
        "capability_evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[ -~]+$"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fingerprint",
              "algorithm",
              "approver",
              "public_key_spki_base64",
              "status",
              "not_before",
              "not_after",
              "boundary_evidence_ref",
              "registration_review_ref"
            ],
            "properties": {
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "algorithm": {
                "const": "RSA-PSS-SHA256"
              },
              "approver": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[ -~]+$"
              },
              "public_key_spki_base64": {
                "type": "string",
                "minLength": 512
              },
              "status": {
                "enum": [
                  "ACTIVE",
                  "REVOKED"
                ]
              },
              "not_before": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$",
                "format": "date-time"
              },
              "not_after": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$",
                "format": "date-time"
              },
              "boundary_evidence_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[ -~]+$"
              },
              "registration_review_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[ -~]+$"
              }
            }
          }
        }
      }
    },
    "auto_after_green": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "target_environment",
        "required_gates"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": true
        },
        "target_environment": {
          "type": "string",
          "enum": [
            "local_wsl",
            "localhost",
            "local_docker"
          ]
        },
        "required_gates": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "string",
            "enum": [
              "PR_MERGED",
              "REMOTE_CI_PASS",
              "AUTOMATED_TESTS_PASS",
              "PLAYWRIGHT_PASS",
              "SECRETS_SCAN_PASS",
              "SOURCE_BUILD_COMMIT_UNAMBIGUOUS",
              "BACKUP_AND_RESTORE_VERIFIED",
              "ROLLBACK_READY",
              "CONTROLLED_WSL_EXECUTOR",
              "HEALTH_AND_SMOKE_RUNNABLE"
            ]
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "max_auto_rollback_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_mode": {
            "const": "LOCAL_AUTHORIZED_KEY"
          }
        },
        "required": [
          "approval_mode"
        ]
      },
      "then": {
        "required": [
          "local_authorized_key"
        ]
      },
      "else": {
        "not": {
          "required": [
            "local_authorized_key"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "release_profile"
        ],
        "properties": {
          "release_profile": {
            "const": "HIGH_ASSURANCE"
          }
        }
      },
      "then": {
        "properties": {
          "approval_mode": {
            "enum": [
              "GITHUB_ENVIRONMENT_REVIEW",
              "LOCAL_AUTHORIZED_KEY"
            ]
          },
          "environment": {
            "const": "production"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "release_profile"
        ],
        "properties": {
          "release_profile": {
            "const": "PERSONAL_LOCAL"
          }
        }
      },
      "then": {
        "properties": {
          "approval_mode": {
            "enum": [
              "OWNER_LOCAL_CONSENT",
              "LOCAL_AUTHORIZED_KEY",
              "GITHUB_ENVIRONMENT_REVIEW",
              "AUTO_AFTER_GREEN"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "release_profile"
        ],
        "properties": {
          "release_profile": {
            "const": "MAINTAINER_RELEASE"
          }
        }
      },
      "then": {
        "properties": {
          "approval_mode": {
            "enum": [
              "MAINTAINER_APPROVAL",
              "GITHUB_ENVIRONMENT_REVIEW"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "approval_mode"
        ],
        "properties": {
          "approval_mode": {
            "const": "OWNER_LOCAL_CONSENT"
          }
        }
      },
      "then": {
        "properties": {
          "release_profile": {
            "const": "PERSONAL_LOCAL"
          }
        },
        "required": [
          "release_profile"
        ]
      }
    },
    {
      "if": {
        "required": [
          "approval_mode"
        ],
        "properties": {
          "approval_mode": {
            "const": "MAINTAINER_APPROVAL"
          }
        }
      },
      "then": {
        "properties": {
          "release_profile": {
            "const": "MAINTAINER_RELEASE"
          }
        },
        "required": [
          "release_profile"
        ]
      }
    },
    {
      "if": {
        "required": [
          "approval_mode"
        ],
        "properties": {
          "approval_mode": {
            "const": "AUTO_AFTER_GREEN"
          }
        }
      },
      "then": {
        "properties": {
          "release_profile": {
            "const": "PERSONAL_LOCAL"
          }
        },
        "required": [
          "release_profile",
          "auto_after_green"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "release_profile"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "approval_mode": {
            "const": "OWNER_LOCAL_CONSENT"
          }
        },
        "required": [
          "approval_mode"
        ]
      },
      "then": {
        "required": [
          "owner_consent"
        ],
        "properties": {
          "environment": {
            "minLength": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "owner_consent"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_mode": {
            "const": "AUTO_AFTER_GREEN"
          }
        },
        "required": [
          "approval_mode"
        ]
      },
      "then": {
        "required": [
          "auto_after_green"
        ]
      },
      "else": {
        "not": {
          "required": [
            "auto_after_green"
          ]
        }
      }
    }
  ]
}
